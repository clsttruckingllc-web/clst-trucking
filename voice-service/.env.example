# Copy to .env on the voice server. Never commit the real .env file.
# Obtain these from RingCentral > Devices & Numbers > Existing Phone > Set Up and Provision > Set up manually using SIP.
SIP_INFO_DOMAIN=sip.ringcentral.com
SIP_INFO_OUTBOUND_PROXY=
SIP_INFO_USERNAME=
SIP_INFO_PASSWORD=
SIP_INFO_AUTHORIZATION_ID=

# Optional raw PCM greeting file, e.g. greeting.raw (16-bit signed little-endian, 16 kHz, mono).
GREETING_RAW_PATH=./greeting.raw

# Keep false until SIP registration and test routing have been verified.
AUTO_ANSWER=true
