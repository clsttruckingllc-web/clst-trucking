# OpenAI Realtime SIP voice service (Dockerfile starts this service).
# Configure real values only in the hosting provider's secret settings.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=marin
ENABLE_INBOUND_GREETING=false
COMPANY_NAME=CLST Trucking LLC
INBOUND_GREETING=Thank you for calling CLST Trucking LLC. How can I help you today?
SIP_INFO_DOMAIN=sip.ringcentral.com
SIP_INFO_OUTBOUND_PROXY=
SIP_INFO_USERNAME=
SIP_INFO_PASSWORD=
SIP_INFO_AUTHORIZATION_ID=
PORT=8080

# Legacy server.js test-call mode (not used by start:ai).
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
VOICE_API_KEY=
TEST_CALL_TO=
TEST_GREETING=Hello, this is CLST Trucking. This is our first automated voice test. Thank you for calling CLST Trucking.
