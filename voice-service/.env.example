# Server-only secrets. Never commit a real .env file.
SIP_INFO_DOMAIN=sip.ringcentral.com
SIP_INFO_OUTBOUND_PROXY=
SIP_INFO_USERNAME=
SIP_INFO_PASSWORD=
SIP_INFO_AUTHORIZATION_ID=

# Existing Gemini API key; keep it in the hosting provider's secret settings.
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts

# Set a new long random secret; used by Authorization: Bearer ... for POST /test-call.
VOICE_API_KEY=

# Use only your own test phone in international E.164 format, for example +17205550123.
TEST_CALL_TO=
TEST_GREETING=Hello, this is CLST Trucking. This is our first automated voice test. Thank you for calling CLST Trucking.
INBOUND_GREETING=Thank you for calling CLST Trucking. Our automated receptionist is currently in a basic test version and cannot yet understand spoken replies. Please contact our office directly for assistance. Thank you.
